{
  "DatabaseProvider": "Sqlite",
  "ConnectionStrings": { "Default": "Data Source=minimes-dev.db" },
  "Cors": { "AllowedOrigins": [ "http://localhost:5173", "http://127.0.0.1:5173" ] },
  // Production SQL Server example:
  // "DatabaseProvider": "SqlServer",
  // "ConnectionStrings": { "Default": "Server=localhost;Database=MiniMESDb;User Id=sa;Password=replace-me;TrustServerCertificate=True" },
  // Development generates an ephemeral Jwt:Key when no key is configured.
  // Production must provide Jwt__Key through a secure configuration source.
  "Jwt": { "Issuer": "MiniMES.Development", "Audience": "MiniMES.Admin", "ExpireMinutes": 60, "RefreshTokenExpireDays": 7, "ClockSkewSeconds": 30, "RefreshTokenDelivery": "Body", "RefreshTokenCookieName": "mini_mes_refresh_token" },
  // Set DataSeed__Admin__Password to choose a fixed password before first startup.
  "DataSeed": { "Admin": { "Enabled": true, "UserName": "admin" } }
}

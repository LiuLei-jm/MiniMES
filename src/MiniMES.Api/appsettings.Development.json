{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "DatabaseProvider": "Sqlite",
  "ConnectionStrings": {
    "Default": "Data Source=minimes-dev.db"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173",
      "http://localhost:4173",
      "http://127.0.0.1:4173"
    ]
  },
  "Jwt": {
    "Issuer": "MiniMES.Development",
    "Audience": "MiniMES.Admin",
    "ExpireMinutes": 60,
    "RefreshTokenExpireDays": 7,
    "ClockSkewSeconds": 30,
    "RefreshTokenDelivery": "Body",
    "RefreshTokenCookieName": "mini_mes_refresh_token"
  },
  "DataSeed": {
    "Admin": {
      "Enabled": true,
      "UserName": "admin"
    }
  }
}
